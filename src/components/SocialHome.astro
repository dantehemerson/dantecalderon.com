---
import { siteConfig } from '../config'
import SocialIcon from './SocialIcon.astro'
---

<div class="text-center">
  {
    siteConfig.social.map(item => (
      <a
        href={item.link}
        title={`${item.title} - ${siteConfig.title}`}
        rel="noopener"
        target="_blank"
        class="mx-0.5 w-6.5 h-6.5 p-1 transition duration-300 inline-block"
      >
        <SocialIcon name={item.icon} label={item.title} class="w-full h-auto m-0" />
      </a>
    ))
  }
</div>
