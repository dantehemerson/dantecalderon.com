---
import { siteConfig } from '../config'
import SocialIcon from './SocialIcon.astro'

const currentYear = new Date().getFullYear()
---

<footer
  class="flex items-center justify-between px-6 mt-4 h-16 border-t border-[#f3f3f3] max-w-225 mx-auto"
>
  <p class="text-[13px] font-semibold text-[#656565] mb-0">
    {siteConfig.title}
    <span>© {currentYear}</span>
  </p>
  <div class="flex items-center gap-2.5">
    {
      siteConfig.social.map(item => (
        <a target="_blank" href={item.link} rel="noopener" class="flex items-center">
          <SocialIcon
            name={item.icon}
            label={`${item.title} - ${siteConfig.title}`}
            color="#656565"
            class="w-5 h-5"
          />
        </a>
      ))
    }
  </div>
</footer>
